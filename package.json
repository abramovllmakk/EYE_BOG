{
  "name": "gql-coverage-proxy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e",
    "test": "pnpm -r run test",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:ui": "playwright test --config e2e/playwright.config.ts",
    "bench": "node bench/overhead.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "test:pg": "PG_URL=${PG_URL:-postgres://gqlcov:gqlcov@127.0.0.1:5432/gqlcov} pnpm --filter @gqlcov/server test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "autocannon": "9.0.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
